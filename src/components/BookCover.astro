---
// Premium book mockup: cover art with a spine shadow, page edges and a soft
// gold aura. Pure CSS — the cover image stays the single source of truth.
import Image from './Img.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  size?: 'sm' | 'md' | 'lg';
  tilt?: boolean;
  eager?: boolean;
}
const { src, alt, size = 'md', tilt = true, eager = false } = Astro.props;
const widths = { sm: [200, 320], md: [320, 480, 640], lg: [420, 640, 860] }[size];
const sizes = { sm: '180px', md: '(min-width: 900px) 340px, 60vw', lg: '(min-width: 900px) 420px, 72vw' }[size];
---

<div class:list={['book', `book--${size}`, { 'book--tilt': tilt }]}>
  <div class="book__aura" aria-hidden="true"></div>
  <div class="book__body">
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} class="book__cover" />
    <span class="book__spine" aria-hidden="true"></span>
    <span class="book__shine" aria-hidden="true"></span>
  </div>
</div>

<style>
  .book {
    --w: 280px;
    position: relative;
    width: min(var(--w), 78vw);
    aspect-ratio: 1200 / 2097;
    margin-inline: auto;
    perspective: 1600px;
  }
  .book--sm { --w: 150px; }
  .book--md { --w: 300px; }
  .book--lg { --w: 380px; }
  .book__aura {
    position: absolute;
    inset: -14% -22%;
    background: radial-gradient(closest-side, rgb(241 199 91 / 0.4), rgb(249 153 62 / 0.12) 55%, transparent 75%);
    filter: blur(8px);
    z-index: 0;
  }
  .book__body {
    position: relative;
    z-index: 1;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform var(--dur-4) var(--ease-out);
    border-radius: 3px 8px 8px 3px;
    box-shadow:
      2px 0 0 #e9dfc8,
      4px 1px 0 #d8ccb1,
      6px 2px 0 #e9dfc8,
      8px 3px 0 #cfc2a5,
      12px 18px 40px -10px rgb(0 0 0 / 0.6),
      0 40px 80px -30px rgb(7 24 46 / 0.7);
  }
  .book--tilt .book__body { transform: rotateY(-14deg) rotateX(2deg); }
  .book--tilt:hover .book__body { transform: rotateY(-6deg) rotateX(1deg); }
  .book__cover { width: 100%; height: 100%; object-fit: cover; border-radius: 3px 8px 8px 3px; }
  .book__spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: 7%;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.45), rgb(255 255 255 / 0.12) 55%, rgb(0 0 0 / 0.2));
    border-radius: 3px 0 0 3px;
  }
  .book__shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgb(255 255 255 / 0.16), transparent 32%, transparent 70%, rgb(255 255 255 / 0.06));
    border-radius: inherit;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .book--tilt .book__body, .book--tilt:hover .book__body { transform: rotateY(-10deg); }
  }
</style>
