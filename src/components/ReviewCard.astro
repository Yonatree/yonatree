---
import type { Review } from '../lib/content';
import { REVIEW_SUBJECTS } from '../lib/site';

interface Props {
  review: Review;
  /** Show the shorter highlight (homepage) instead of the full quote. */
  short?: boolean;
}
const { review, short = false } = Astro.props;
const { name, location, note, quote, highlight, about } = review.data;
const text = short && highlight ? highlight : quote;
const paragraphs = text.trim().split(/\n\s*\n/);
const meta = [note, location].filter(Boolean).join(' · ');
const subjects = about.map((slug) => REVIEW_SUBJECTS.find((s) => s.slug === slug)?.label).filter(Boolean);
---

<figure class="review">
  <blockquote class="review__quote">
    {paragraphs.map((p, i) => <p>{i === 0 && '“'}{p}{i === paragraphs.length - 1 && '”'}</p>)}
  </blockquote>
  <figcaption class="review__by">
    <span class="review__name">{name}</span>
    {meta && <span class="review__meta">{meta}</span>}
    {subjects.length > 0 && (
      <ul class="review__about" role="list" aria-label="About">
        {subjects.map((s) => <li>{s}</li>)}
      </ul>
    )}
  </figcaption>
</figure>

<style>
  .review {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    height: 100%;
    margin: 0;
    padding: var(--s-7) var(--s-6) var(--s-6);
    border-radius: var(--r-lg);
    background: var(--card);
    border: 1px solid var(--line);
  }
  .review::before {
    content: '“';
    position: absolute;
    top: -0.1em;
    left: var(--s-5);
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 1;
    color: var(--c-gold);
    opacity: 0.55;
    pointer-events: none;
  }
  .review__quote {
    display: grid;
    gap: 0.8em;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    font-style: italic;
    line-height: 1.6;
  }
  .review__quote p { margin: 0; }
  .review__by { display: grid; gap: 2px; margin-top: auto; }
  .review__name { font-family: var(--font-display); font-weight: 600; color: var(--accent); }
  .review__meta { font-size: var(--fs-sm); color: var(--fg-2); }
  .review__about { display: flex; flex-wrap: wrap; gap: var(--s-2); margin: var(--s-3) 0 0; padding: 0; }
  .review__about li {
    padding: 2px 10px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--fg-2);
  }
</style>
