// `rest` carries Astro's scoped-style attribute so parents can style the icon.
const { name, size = 24, label, class: className, ...rest } = Astro.props;
const body = ICONS[name] ?? ICONS.star;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', className]}
  {...rest}
  {...a11y}
  set:html={body}
/>
