---
import '@fontsource-variable/cinzel';
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-400-italic.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import '../styles/prose.css';

import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import logo from '../assets/brand/yona-tree-logo.png';
import defaultOg from '../assets/art/biblical-mysteries-triptych.jpg';
import cinzelLatin from '@fontsource-variable/cinzel/files/cinzel-latin-wght-normal.woff2?url';
import { settings, absoluteUrl } from '../lib/site';
import { organization, website, graphLd } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article' | 'video.other' | 'book' | 'profile';
  noindex?: boolean;
  jsonLd?: object[];
  /** Pagefind result type: Article, Video, Book, Study, Page. Omit to exclude from search. */
  searchType?: string;
  bodyClass?: string;
  publishedTime?: Date;
}

const {
  title,
  description = settings.description,
  image = defaultOg,
  imageAlt = 'Yona Tree — the burning bush, the menorah and the Tree of Life joined by light flowing from an open Bible.',
  type = 'website',
  noindex = false,
  jsonLd = [],
  searchType,
  bodyClass,
  publishedTime,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = absoluteUrl(og.src);
const logoUrl = absoluteUrl((await getImage({ src: logo, width: 512, format: 'png' })).src);
const fullTitle = title.includes('Yona Tree') ? title : `${title} | Yona Tree`;
const ld = graphLd(organization(logoUrl), website(), ...jsonLd);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#07182e" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Yona Tree Articles" href="/rss.xml" />
    <link rel="preload" href={cinzelLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1" data-pagefind-body={searchType ? '' : undefined}>
      {searchType && <span data-pagefind-filter={`type:${searchType}`} data-pagefind-meta={`type:${searchType}`} />}
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
