---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import StudyCard from '../../components/StudyCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import { getStudies, getTopics } from '../../lib/content';
import { STUDIES_MENU } from '../../lib/site';
import { breadcrumbs } from '../../lib/schema';
import heroArt from '../../assets/art/lady-wisdom-tree-of-life.jpg';

const [studies, topics] = await Promise.all([getStudies(), getTopics()]);
const topicHubs = STUDIES_MENU.filter((m) => m.href.startsWith('/topics/'));
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Studies', href: '/studies/' }];
---

<BaseLayout
  title="Studies — The Holy Trinity, Holy Spirit, Lady Wisdom, Tree of Life & New Jerusalem"
  description="Yona Tree study hubs: the Holy Trinity, the Holy Spirit, Lady Wisdom, the seven lamps, the Tree of Life, New Jerusalem, Luke 15 and the dwelling of the righteous."
 
  jsonLd={[breadcrumbs(crumbs)]}
>
  <PageHero
    eyebrow="Study Library"
    title="Studies"
    lede="Each study gathers the Scriptures, history and symbolism behind one theme, clearly distinguishing the biblical text from interpretation — and links to the articles, episodes and book chapters that explore it further."
    image={heroArt}
    imagePosition="center 30%"
    crumbs={crumbs}
  />

  <section class="section surface-parchment" aria-labelledby="studies-title">
    <div class="container">
      <SectionHeading eyebrow={`${studies.length} studies`} title="Featured studies" id="studies-title" />
      <ul class="grid grid--4 studies" role="list">
        {studies.map((s) => <li><StudyCard study={s} variant="arch" /></li>)}
      </ul>
    </div>
  </section>

  <section class="section surface-white" aria-labelledby="hubs-title">
    <div class="container">
      <SectionHeading
        eyebrow="Topic hubs"
        title="Follow a theme"
        id="hubs-title"
        lede="Topic hubs collect every article, episode and study on a subject automatically as new content is published."
      />
      <ul class="hubs" role="list">
        {
          topicHubs.map((h) => (
            <li>
              <a class="hub" href={h.href}>
                <span class="hub__icon"><Icon name={h.icon} size={24} /></span>
                <span><span class="hub__label">{h.label}</span><span class="hub__note">{h.note}</span></span>
                <Icon name="arrow-right" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="all-topics"><a class="text-link" href="/topics/">All {topics.length} topics <Icon name="arrow-right" size={16} /></a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .studies { margin: 0; }
  .hubs { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: var(--s-3); margin: 0; }
  .hub {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    background: var(--c-parchment);
    color: var(--fg);
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }
  .hub:hover { border-color: var(--accent); transform: translateY(-2px); }
  .hub > :global(svg:last-child) { color: var(--accent); }
  .hub__icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; color: var(--c-olive); border: 1px solid rgb(146 102 37 / 0.3); }
  .hub__label { display: block; font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; }
  .hub__note { display: block; font-size: var(--fs-xs); color: var(--fg-2); }
  .all-topics { margin-top: var(--s-6); }
</style>
