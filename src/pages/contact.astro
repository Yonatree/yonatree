---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { settings } from '../lib/site';
import { breadcrumbs } from '../lib/schema';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact/' }];
const netlify = settings.forms.provider === 'netlify';
const turnstile = settings.forms.provider === 'cloudflare' && settings.forms.turnstileSiteKey;
const subjects = ['A question about a study or article', 'The book or audiobook', 'The video series', 'Partnering with Yona Tree', 'Media or speaking', 'Something else'];
---

<BaseLayout title="Contact Yona Tree" description="Send Yona Tree a question about a study, the book Seven Lamps Before the Throne, the video series, or partnering with the ministry." searchType="Page" jsonLd={[breadcrumbs(crumbs)]}>
  <PageHero eyebrow="Contact" title="Write to Yona Tree" lede="Questions about a study, the book or the series are welcome. We read every message." crumbs={crumbs} />

  <section class="section surface-parchment">
    <div class="container contact">
      <form
        class="contact__form"
        name="contact"
        method="POST"
        action={settings.forms.contactAction}
        data-netlify={netlify ? 'true' : undefined}
        netlify-honeypot={netlify ? 'bot-field' : undefined}
        novalidate
        data-contact-form
      >
        {netlify && <input type="hidden" name="form-name" value="contact" />}
        <p class="visually-hidden"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="contact__summary" role="alert" tabindex="-1" hidden data-summary>
          <p><strong>Please correct the following:</strong></p>
          <ul></ul>
        </div>
        <div class="contact__row">
          <div class="field">
            <label for="c-name">Name <span aria-hidden="true">*</span></label>
            <input class="input" id="c-name" name="name" autocomplete="name" required aria-describedby="c-name-err" />
            <p class="field-error" id="c-name-err" hidden>Please enter your name.</p>
          </div>
          <div class="field">
            <label for="c-email">Email <span aria-hidden="true">*</span></label>
            <input class="input" id="c-email" name="email" type="email" inputmode="email" autocomplete="email" required aria-describedby="c-email-err" />
            <p class="field-error" id="c-email-err" hidden>Please enter a valid email address, like name@example.com.</p>
          </div>
        </div>
        <div class="field">
          <label for="c-subject">Subject</label>
          <select class="select" id="c-subject" name="subject">
            {subjects.map((s) => <option>{s}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="c-message">Message <span aria-hidden="true">*</span></label>
          <textarea class="textarea" id="c-message" name="message" required aria-describedby="c-message-hint c-message-err"></textarea>
          <p class="hint" id="c-message-hint">If your question is about a particular article or episode, include its title.</p>
          <p class="field-error" id="c-message-err" hidden>Please write a message.</p>
        </div>
        <p class="hint">Fields marked * are required. We use your details only to reply to you — see our <a href="/privacy/">privacy policy</a>.</p>
        {turnstile && <div class="cf-turnstile" data-sitekey={turnstile} data-theme="light"></div>}
        <button class="btn btn--bronze" type="submit"><Icon name="mail" size={18} /> Send message</button>
      </form>
      {turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

      <aside class="contact__aside">
        <h2 class="contact__h">Follow Yona Tree</h2>
        <ul role="list" class="contact__social">
          {settings.social.map((s) => (
            <li><a href={s.url} rel="noopener" target="_blank"><Icon name={s.icon} size={20} /> {s.name}<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          ))}
        </ul>
        {settings.contactEmail && <p><a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a></p>}
        <p class="contact__place"><Icon name="home" size={18} /> {settings.location}</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; gap: var(--s-8); }
  @media (min-width: 960px) { .contact { grid-template-columns: minmax(0, 1.5fr) 1fr; } }
  .contact__form { display: grid; gap: var(--s-5); padding: clamp(1.25rem, 1rem + 2vw, 2.5rem); border-radius: var(--r-lg); background: var(--c-white); border: 1px solid var(--line); box-shadow: var(--shadow-card); }
  .contact__form .btn { justify-self: start; }
  .contact__row { display: grid; gap: var(--s-5); }
  @media (min-width: 640px) { .contact__row { grid-template-columns: 1fr 1fr; } }
  .contact__summary { padding: var(--s-4); border-radius: var(--r-sm); border: 1px solid #b3261e; background: #fdecea; color: #6b1510; }
  .contact__summary ul { margin: var(--s-2) 0 0; padding-left: 1.2em; }
  .contact__summary a { color: inherit; }
  .contact__h { margin-bottom: var(--s-4); font-family: var(--font-sans); font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); }
  .contact__social { display: grid; gap: var(--s-2); margin: 0 0 var(--s-5); }
  .contact__social a { display: inline-flex; align-items: center; gap: var(--s-3); min-height: 44px; color: var(--fg); }
  .contact__place { display: flex; align-items: center; gap: var(--s-2); color: var(--fg-2); }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const summary = form.querySelector<HTMLElement>('[data-summary]')!;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];
    const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const ok = el.value.trim() !== '' && el.validity.valid;
      const err = document.getElementById(`${el.id}-err`);
      if (err) err.hidden = ok;
      el.setAttribute('aria-invalid', String(!ok));
      return ok;
    };
    fields.forEach((el) => el.addEventListener('blur', () => el.value && check(el)));
    form.addEventListener('submit', (e) => {
      const bad = fields.filter((el) => !check(el));
      if (!bad.length) return;
      e.preventDefault();
      const list = summary.querySelector('ul')!;
      list.innerHTML = '';
      for (const el of bad) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${el.id}`;
        a.textContent = document.getElementById(`${el.id}-err`)?.textContent ?? 'Check this field';
        li.append(a);
        list.append(li);
      }
      summary.hidden = false;
      summary.focus();
    });
  }
</script>
